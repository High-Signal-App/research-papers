---
import "../styles/globals.css";
import SiteNav from "@/components/site-nav.astro";
import { changelogEntries } from "@/data/changelog";

const changelogJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Research Papers changelog",
  description: "Verified improvements available on the public Research Papers site.",
  url: "https://papers.highsignal.app/changelog",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: changelogEntries.length,
    itemListElement: changelogEntries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: entry.title,
    })),
  },
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Verified improvements that are available on the public Research Papers site."
    />
    <link rel="canonical" href={new URL("/changelog", Astro.site)} />
    <link rel="alternate" type="text/markdown" href="https://papers.highsignal.app/changelog.md" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Research Papers: Changelog</title>
    <meta property="og:title" content="Research Papers: Changelog" />
    <meta property="og:description" content="Verified improvements that are available on the public Research Papers site." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://papers.highsignal.app/changelog" />
    <meta property="og:image" content="https://papers.highsignal.app/icon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Research Papers: Changelog" />
    <meta name="twitter:description" content="Verified improvements that are available on the public Research Papers site." />
    <meta name="twitter:image" content="https://papers.highsignal.app/icon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(changelogJsonLd)} />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased font-sans">
    <SiteNav active="changelog" />

    <main class="mx-auto max-w-5xl px-6 py-14 sm:py-20">
      <header class="max-w-3xl border-b pb-10">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Product changelog</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">What changed</h1>
        <p class="mt-5 text-base leading-7 text-muted-foreground sm:text-lg">
          Verified improvements to the public research experience, newest first.
          Open work stays in GitHub Issues; this page describes shipped outcomes.
        </p>
      </header>

      <section class="divide-y" aria-label="Shipped changes">
        {changelogEntries.map((entry) => (
          <article class="grid gap-4 py-8 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-8">
            <time
              datetime={entry.date}
              class="pt-1 font-mono text-xs font-semibold uppercase tracking-wider text-primary"
            >
              {entry.date}
            </time>
            <div>
              <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{entry.title}</h2>
              <ul class="mt-4 space-y-3 text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7">
                {entry.outcomes.map((outcome) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mt-[0.7em] size-1.5 shrink-0 rounded-full bg-primary"></span>
                    <span>{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <nav class="flex flex-wrap gap-x-6 gap-y-3 border-t pt-7 text-sm" aria-label="Project links">
        <a
          href="https://github.com/High-Signal-App/research-papers/issues"
          class="font-medium text-muted-foreground hover:text-primary"
        >
          Roadmap ↗
        </a>
        <a
          href="https://github.com/High-Signal-App/research-papers"
          class="font-medium text-muted-foreground hover:text-primary"
        >
          Source ↗
        </a>
        <a href="/" class="font-medium text-muted-foreground hover:text-primary">Dashboard →</a>
      </nav>
    </main>

    <footer class="mx-auto max-w-5xl border-t px-6 py-10 text-xs text-muted-foreground">
      <p>488,491 papers · 1.05M citation edges · 64 semantic clusters</p>
    </footer>
  </body>
</html>
