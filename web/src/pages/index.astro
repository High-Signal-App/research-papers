---
import "../styles/globals.css";
import { EmbeddingClusters } from "@/components/embedding-clusters";
import { RagAsk } from "@/components/rag-ask";
import { SemanticSearch } from "@/components/semantic-search";
import SiteNav from "@/components/site-nav.astro";

import { CitedWorksTable } from "@/components/tables/cited-works-table";
import { HotTable } from "@/components/tables/hot-table";
import { PapersTable } from "@/components/tables/papers-table";
import { SleepersTable } from "@/components/tables/sleepers-table";
import { TagRatingTable } from "@/components/tables/tag-rating-table";
import { totalPapersLabel, totalPapersShort } from "@/lib/corpus-stats";
import { makeInlineSafe } from "@/lib/inline-safe-data";
import embeddingClusters from "../../public/data/embedding_clusters.json";
import hot from "../../public/data/hot.json";
import sleepers from "../../public/data/sleepers.json";
import tagRating from "../../public/data/tag_rating.json";

const inlineSafeTagRating = makeInlineSafe(tagRating);
const inlineSafeSleepers = makeInlineSafe(sleepers);
const inlineSafeHot = makeInlineSafe(hot);
const inlineSafeEmbeddingClusters = makeInlineSafe(embeddingClusters);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Investigate technical and market questions with a retained ${totalPapersShort}-paper corpus, selected public research indexes, citation signals, and cited answers.`} />
    <link rel="canonical" href={new URL(Astro.url.pathname.replace(/^\/index(?:\.html)?$/, "/").replace(/\.html$/, ""), Astro.site)} />
    <link rel="alternate" type="text/markdown" href="https://papers.highsignal.app/index.md" />
    <link rel="service-desc" type="application/vnd.oai.openapi+json;version=3.1" href="https://papers.highsignal.app/openapi.json" />
    <link rel="ard" type="application/json" href="https://papers.highsignal.app/.well-known/ard.json" />
    <link rel="ai-catalog" type="application/json" href="https://papers.highsignal.app/.well-known/ai-catalog.json" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js?v=precise-b0adaa67"></script>
    <title>Research Papers: A {totalPapersShort}-paper library for concrete questions</title>
    <meta property="og:title" content={`Research Papers: A ${totalPapersShort}-paper library for concrete questions`} />
    <meta property="og:description" content="Use selected research indexes, citation signals, reading paths, and cited answers to investigate a technical or market question." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://papers.highsignal.app/" />
    <meta property="og:site_name" content="Research Papers" />
    <meta property="og:image" content="https://papers.highsignal.app/icon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Research Papers: A ${totalPapersShort}-paper library for concrete questions`} />
    <meta name="twitter:description" content="Use selected research indexes, citation signals, reading paths, and cited answers to investigate a technical or market question." />
    <meta name="twitter:image" content="https://papers.highsignal.app/icon.svg" />
  <!-- fleet-jsonld:start (generated by apply-agent-surfaces; edit registry, not this) -->
<script is:inline type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://sarthakagrawal.dev/#person","name":"Sarthak Agrawal","jobTitle":"AI Infrastructure & Product Engineer","url":"https://sarthakagrawal.dev","image":"https://avatars.githubusercontent.com/u/43884471?v=4","sameAs":["https://sarthakagrawal.dev","https://www.linkedin.com/in/sarthakagrawal927","https://github.com/sarthakagrawal927","https://x.com/sarthakcodes","https://huggingface.co/sarthakagrawal927"],"knowsAbout":["AI infrastructure","Local-first software","Post-training language models","AI code review","Cloudflare Workers","TypeScript","Rust"],"affiliation":{"@type":"Organization","@id":"https://sassmaker.com/#app","name":"SaaS Maker","url":"https://sassmaker.com"}},{"@type":"WebSite","@id":"https://papers.highsignal.app/#app","name":"Research Papers","url":"https://papers.highsignal.app","description":"A maintained research library with a {totalPapersLabel}-record operator corpus, a 478,991-record public analytics snapshot, selected indexes, citation analytics, reading paths, and cited answers.","publisher":{"@id":"https://sarthakagrawal.dev/#person"},"sameAs":["https://github.com/High-Signal-App/research-papers"]}]}</script>
<!-- fleet-jsonld:end -->
  <script is:inline src="/app-health-log.js" defer></script>
  <script is:inline defer src="https://health.sassmaker.com/tracker.js" data-key="ahk_pub_36415d625ac53d77a9f1122e1821bf625cd9679d16acf20a7894a22a80807ddb" data-project="app-import-327fdd563981d4233ec4c42e7cc433da1c4a268dd2c20a1130523d7f1dbac47f" data-identity="persistent"></script>
</head>
  <body class="min-h-screen antialiased font-sans">
    <SiteNav active="dashboard" />

    <main>
    <header class="research-hero">
      <div class="research-hero-inner">
        <div>
          <p class="research-kicker">Maintained research library</p>
          <h1 class="research-title">Start with a real question. Find the research that shapes the answer.</h1>
          <p class="research-lede">
            The operator corpus retains {totalPapersLabel} records from arXiv, OpenReview, bioRxiv, and medRxiv
            for researchers, product builders, and operators investigating a technical or market question.
            The public site offers selected indexes, citation and reviewer signals, reading paths, and cited answers.
          </p>
          <div class="research-actions">
            <a href="#search" class="research-primary-action">Search the public index &rarr;</a>
            <a href="/paths" class="research-secondary-action">Browse reading paths</a>
          </div>
          <p class="research-state">Browse without an account or checkout. The cited-answer route uses bot verification. Public API details are available in the <a href="/openapi.json">OpenAPI document</a>.</p>
        </div>
        <dl class="corpus-ledger" aria-label="Current corpus evidence">
          <div><dt>Operator corpus</dt><dd>{totalPapersLabel}</dd></div>
          <div><dt>Public snapshot</dt><dd>478,991</dd></div>
          <div><dt>Source collections</dt><dd>04</dd></div>
          <div><dt>Semantic clusters</dt><dd>64</dd></div>
        </dl>
      </div>
    </header>

    <section class="research-entry-intro" aria-labelledby="entry-heading">
      <div>
        <p class="research-kicker">Choose an entry point</p>
        <h2 id="entry-heading">Search the deployed index or ask for a cited synthesis.</h2>
      </div>
      <p>
        Public search works over selected static exports from the retained corpus. The answer route
        combines those research signals with the live Knowledgebase path and keeps citations attached.
      </p>
    </section>

    <section id="search" class="max-w-7xl mx-auto px-6 pb-8" data-clarity-mask="true">
      <div class="research-tool p-6 md:p-8 space-y-4">
        <div class="research-tool-label">
          <h2>Public corpus search</h2>
          <span>INDEX / 01</span>
        </div>
        <div>
          <p class="text-sm text-muted-foreground mt-1">
            Search the deployed paper slice by title, topic, venue, citations, and reviewer signals.
            Try <span class="font-mono text-foreground/70">emergent capabilities</span> or <span class="font-mono text-foreground/70">diffusion model training instability</span>.
          </p>
        </div>
        <SemanticSearch client:load />
      </div>
    </section>

    <section id="rag" class="max-w-7xl mx-auto px-6 pb-8" data-clarity-mask="true">
      <div class="research-tool p-6 md:p-8 space-y-4">
        <div class="research-tool-label">
          <h2>Cited research answer</h2>
          <span>ANSWER / 02</span>
        </div>
        <div>
          <p class="text-sm text-muted-foreground mt-1">
            Ask a focused question. The live route retrieves relevant research signals and returns a concise answer with citations.
            Turnstile protects this public endpoint from automated abuse.
          </p>
        </div>
        <RagAsk client:load />
      </div>
    </section>

    {inlineSafeHot?.length > 0 && (
      <section id="hot" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
        <div class="research-section-heading space-y-1">
          <h2 class="text-2xl font-semibold tracking-tight">Hot right now</h2>
          <p class="text-sm text-muted-foreground">
            Recent papers combining citation velocity, peer-review signal where available, and graph centrality.
          </p>
        </div>
        <HotTable client:visible src="/data/hot.json" />
      </section>
    )}

    {inlineSafeSleepers?.length > 0 && (
      <section id="sleepers" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
        <div class="research-section-heading space-y-1">
          <h2 class="text-2xl font-semibold tracking-tight">Reviewer-loved early work</h2>
          <p class="text-sm text-muted-foreground">
            High OpenReview scores on recent submissions. Citation counts for OpenReview-only records are hidden until a verified citation crosswalk is added.
          </p>
        </div>
        <SleepersTable client:visible src="/data/sleepers.json" />
      </section>
    )}

    {inlineSafeTagRating?.length > 0 && (
      <section id="tag-rating" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
        <div class="research-section-heading space-y-1">
          <h2 class="text-2xl font-semibold tracking-tight">Topics reviewers are most excited about</h2>
          <p class="text-sm text-muted-foreground">
            Mean reviewer rating by extracted topic. This is the compact view of what top venues are rewarding.
          </p>
        </div>
        <TagRatingTable client:visible src="/data/tag_rating.json" />
      </section>
    )}

    {inlineSafeEmbeddingClusters?.length > 0 && (
      <section id="clusters" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
        <div class="research-section-heading space-y-1">
          <h2 class="text-2xl font-semibold tracking-tight">Research map</h2>
          <p class="text-sm text-muted-foreground">
            Semantic clusters from MiniLM embeddings. Use this as the one map of the corpus, not a separate diagnostics area.
          </p>
        </div>
        <EmbeddingClusters client:visible src="/data/embedding_clusters.json" />
      </section>
    )}

    <section id="top-papers" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
      <div class="research-section-heading space-y-1">
        <h2 class="text-2xl font-semibold tracking-tight">Top papers</h2>
        <p class="text-sm text-muted-foreground">The strongest papers in the corpus by citations and graph centrality.</p>
      </div>
      <PapersTable client:visible src="/data/top_papers.json" />
    </section>

    <section id="cited-works" class="max-w-7xl mx-auto px-6 py-8 space-y-3">
      <div class="research-section-heading space-y-1">
        <h2 class="text-2xl font-semibold tracking-tight">What the field cites</h2>
        <p class="text-sm text-muted-foreground">Works most cited by the corpus, useful as a compact reading list of durable foundations.</p>
      </div>
      <CitedWorksTable client:visible src="/data/top_cited_works.json" />
    </section>
    </main>

    <footer aria-label="Research Papers footer">
    <fleet-footer-extension
      data-fleet-footer-project="research-papers"
      product-name="Research Papers"
      art-src="/footer-art/research-papers.webp"
      art-alt="A research reading gallery centers one open paper under a study lamp, with a visible citation thread leading back to its scholarly shelf. Indexed volumes, a magnifier and restrained specimen trays frame the study area."
      art-width="2169"
      art-height="725"
      art-position="50% 50%"
      art-credit="Original illustration for Research Papers"
      surface="web"
      theme="light"
      font-base="/fonts/fleet-footer-precise-v1/"
      signature-font="inherit"
      style="font-family: Georgia, 'Times New Roman', serif;"
    >
      <a slot="cta" data-fleet-footer-cta href="#search">Search the public index →</a>
      <saas-maker-newsletter-capture
        slot="capture"
        product-name="Research Papers"
        catalog-id="research-papers"
        kind="newsletter"
        source="footer"
        privacy-url="https://sassmaker.com/privacy"
        theme="light"
        layout="compact"
        integrated
      ></saas-maker-newsletter-capture>
    <div slot="navigation" data-fleet-footer-navigation class="research-footer">
      <div class="research-footer-capture">
        <p>Occasional notes when the public paper snapshot, curated paths, or cited-answer demo materially changes.</p>
      </div>
      <div>
        <p class="research-kicker">Research Papers</p>
        <strong>A retained research library for questions worth investigating.</strong>
      </div>
      <div>
        <p>Operator corpus: {totalPapersLabel} records. Deployed analytics snapshot: 478,991 records. Public search uses selected exports; operator-side ClickHouse maintains the complete corpus.</p>
        <p class="mt-2">The public site and cited-answer demo currently need no account or checkout. No permanent pricing model is claimed.</p>
      </div>
      <div class="flex flex-col items-start gap-2">
        <a href="/data">Corpus and provenance</a>
        <a href="/paths">Curated reading paths</a>
        <a href="/changelog">Changelog</a>
        <a
          href="https://github.com/High-Signal-App/research-papers"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub repository"
          title="GitHub repository"
          class="inline-flex items-center"
          ><svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"
            ><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          ></a
        >
      </div>
    </div>
    </fleet-footer-extension>
    </footer>

    <script src="/api-config.js" is:inline></script>

    <!-- PostHog + API timing -->
    <script>
      import { trackAppHealth } from '@/lib/app-health';
      import { installBrowserMonitoring } from '@/lib/foundry-monitoring';
      import { initApiTiming } from '@/lib/api-timing';
      document.querySelector('.research-secondary-action')?.addEventListener('click', () => {
        trackAppHealth('reading_paths_opened');
      });
      installBrowserMonitoring();
      initApiTiming();
    </script>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js?v=precise-b0adaa67"
      data-project="research-papers"
      data-host-only="true"
      data-theme="light"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js?v=precise-b0adaa67"
      data-name="Research Papers"
      data-project="research-papers"
      data-host-only="true"
      data-theme="light"
      data-surface="web"
      data-capture="false"
      defer
    ></script>
  </body>
</html>
