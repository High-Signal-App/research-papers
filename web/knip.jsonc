{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "astro.config.mjs",
    "functions/**/*.ts",
    "scripts/**/*.mjs",
    "src/lib/api-timing.ts",
    "src/lib/foundry-monitoring.ts",
    "src/pages/**/*.{astro,ts}",
    "../tests/**/*.test.mjs"
  ],
  "project": [
    "astro.config.mjs",
    "functions/**/*.ts",
    "scripts/**/*.mjs",
    "src/**/*.{astro,ts,tsx}",
    "../tests/**/*.test.mjs"
  ],
  "ignoreDependencies": [
    "@astrojs/check",
    "@biomejs/biome",
    "jscpd",
    "knip",
    "lightningcss",
    "tailwindcss",
    "tw-animate-css",
    "typescript"
  ]
}
